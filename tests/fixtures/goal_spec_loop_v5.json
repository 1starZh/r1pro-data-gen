        "reference": "target",
        "region": {"shape": "cuboid", "center": [0.0, 0.0, 0.055], "size": [0.16, 0.16, 0.12]}
      }
    }
  ],
  "invariants": [
    {"predicate": "collision_free", "arguments": {"subject": "cylinder"}}
  ]
}
